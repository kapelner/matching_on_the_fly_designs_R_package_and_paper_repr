\if{latex}{\out{\hypertarget{method-InferenceAsymp-compute_asymp_two_sided_pval}{}}}
\subsection{\code{InferenceAsymp$compute_asymp_two_sided_pval()}}{
  Computes an asymptotic two-sided p-value for the treatment
  effect using the configured large-sample test. For the default Wald path,
  the method compares \code{compute_estimate()} to the null value
  \code{delta} using the class-specific standard error and a normal or t
  reference distribution. Likelihood-backed subclasses may override the
  dispatch; see \code{\link[EDI:InferenceAsympLik]{InferenceAsympLik}}.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{InferenceAsymp$compute_asymp_two_sided_pval(delta = 0)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{delta}}{Null treatment effect to test against. Default 0.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    The asymptotic p-value.
  }
}

