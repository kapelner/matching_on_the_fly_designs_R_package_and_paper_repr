\deqn{SE(\hat\tau) = \frac{2}{n}\sqrt{\sum_b \frac{n_{1b}\,n_{0b}}{n_B - 1}}}{SE = (2/n) * sqrt(sum_b n1b*n0b / (nB - 1))}
